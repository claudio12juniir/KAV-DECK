DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

PORT=3000
NODE_ENV=development
# Settings > API > Project URL no painel do Supabase — usado para buscar as
# chaves públicas de verificação de JWT (JWKS)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# Usado apenas por prisma/seed.js para criar o primeiro Usuario/Empresa
SEED_EMPRESA_CNPJ="00000000000000"
SEED_EMPRESA_RAZAO_SOCIAL="Empresa Demo"
SEED_ADMIN_SUPABASE_USER_ID="[uuid do usuario criado no Supabase Auth]"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NOME="Administrador"

# Painel de developers do Mercado Pago > sua aplicação > Credenciais de teste
# (em produção, usar "Credenciais de produção" com o mesmo nome de variável)
MERCADOPAGO_PUBLIC_KEY="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxx"
# Painel MP > sua aplicação > Webhooks > chave secreta — só existe depois de
# cadastrar lá a URL de produção (https://SEU-DOMINIO/api/v1/mercado-pago/webhook).
# Sem essa variável o webhook aceita notificações sem validar assinatura
# (ver validarAssinaturaWebhook em src/lib/mercadoPago.js) — configurar antes
# de ir pra produção de verdade.
MERCADOPAGO_WEBHOOK_SECRET="[chave secreta do webhook, gerada ao cadastrar a URL no painel]"

# app.nfe.io > Conta > Chaves de Acesso — chave "Nota Fiscal" da conta master
# da KAV DECK. Cada Empresa cadastrada no sistema vira uma "Company" separada
# dentro dessa MESMA conta (ver src/lib/nfeio.js e ConfiguracaoFiscal) — não
# precisa (nem deve) gerar uma chave por cliente.
NFEIO_API_KEY="[chave 'Nota Fiscal' gerada em app.nfe.io > Conta > Chaves de Acesso]"
