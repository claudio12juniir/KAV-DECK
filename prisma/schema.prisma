generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================================================
// ENUMS
// =========================================================================

enum RoleUsuario {
  ADMIN
  COMPRADOR
  VENDEDOR
  SEPARADOR
  FINANCEIRO
  FISCAL
  ESTOQUE
  GESTOR
}

enum TipoColaborador {
  COMPRADOR
  VENDEDOR
  REPRESENTANTE
  SEPARADOR
}

enum TipoPessoa {
  FISICA
  JURIDICA
}

enum TipoEndereco {
  PRINCIPAL
  COBRANCA
  ENTREGA
}

enum StatusBloqueioCliente {
  LIBERADO
  BLOQUEADO
}

enum StatusPedidoCompra {
  ABERTO
  APROVADO
  RECEBIDO_PARCIAL
  RECEBIDO
  CANCELADO
}

enum StatusPedidoVenda {
  ABERTO
  SEPARACAO
  FATURADO
  CANCELADO
}

enum TurnoEntrega {
  MANHA
  TARDE
  NOITE
  SOS
  RETIRA
}

enum TipoMovimentoEstoque {
  ENTRADA
  SAIDA
  TRANSFERENCIA
  PERDA
  AJUSTE_INVENTARIO
  AJUSTE_MANUAL
  DEVOLUCAO
}

enum StatusBloqueio {
  SOLICITADO
  EM_ANALISE
  AUTORIZADO
  NEGADO
}

enum TipoBloqueio {
  BLOQUEAR
  DESBLOQUEAR
}

enum TipoMovimentoComodato {
  ENTREGA
  DEVOLUCAO
}

enum TipoTitulo {
  PAGAR
  RECEBER
}

enum StatusTitulo {
  ABERTO
  BAIXADO
  VENCIDO
  CANCELADO
  // Título original de um parcelamento: foi substituído pelos títulos
  // filhos (ver TituloFinanceiro.tituloOrigemId) e não circula mais em
  // aberto nem conta como cancelado (não foi uma desistência, virou outra
  // coisa).
  SUBSTITUIDO
}

enum StatusCheque {
  EM_CARTEIRA
  COMPENSADO
  DEVOLVIDO
}

enum TipoOperacaoNF {
  ENTRADA
  SAIDA
  PRODUTOR_RURAL
  TERCEIROS
  INUTILIZACAO
}

// Eixo diferente de TipoOperacaoNF: aqui é o modelo do documento fiscal em
// si (NF-e 55, NFC-e 65, ou formulário avulso), não a direção da operação.
enum ModeloDocumentoNF {
  NFE
  NFCE
  NF_FORMULARIO
}

enum AmbienteFiscal {
  HOMOLOGACAO
  PRODUCAO
}

enum StatusNotaFiscal {
  EM_DIGITACAO
  AUTORIZADO
  CANCELADO
  USO_DENEGADO
  REJEICAO
  ARQUIVO_CRIADO
  EM_PROCESSAMENTO
}

enum TipoEventoManifestacao {
  CIENCIA
  CONFIRMACAO
  DESCONHECIMENTO
  NAO_REALIZADA
}

// =========================================================================
// TENANT / AUTH
// =========================================================================

model Empresa {
  id              String   @id @default(uuid()) @db.Uuid
  razaoSocial     String   @map("razao_social")
  cnpj            String   @unique
  telefone        String?
  emailServico    String?  @map("email_servico")
  logotipoDataUrl String?  @map("logotipo_data_url")
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  usuarios             Usuario[]
  colaboradores        Colaborador[]
  departamentos        Departamento[]
  categorias           Categoria[]
  unidadesMedida       UnidadeMedida[]
  produtos             Produto[]
  regrasIcms           RegraIcms[]
  regrasIpi            RegraIpi[]
  regrasPis            RegraPis[]
  regrasCofins         RegraCofins[]
  regrasIbs            RegraIbs[]
  regrasCbs            RegraCbs[]
  tabelasPreco         TabelaPreco[]
  condicoesPagamento   CondicaoPagamento[]
  participantes        Participante[]
  gruposEmpresas       GrupoEmpresas[]
  transportadoras      Transportadora[]
  rotasEntrega         RotaEntrega[]
  pedidosCompra        PedidoCompra[]
  pedidosVenda         PedidoVenda[]
  lotes                Lote[]
  movimentosEstoque    MovimentoEstoque[]
  inventariosFisicos   InventarioFisico[]
  tiposCaixaEmbalagem  TipoCaixaEmbalagem[]
  movimentosComodato   MovimentoComodato[]
  titulosFinanceiros   TituloFinanceiro[]
  movimentosCaixa      MovimentoCaixa[]
  contasBancarias      ContaBancaria[]
  planosContas         PlanoContas[]
  centrosCusto         CentroCusto[]
  chequesEmitidos      ChequeEmitido[]
  chequesTerceiros     ChequeTerceiro[]
  notasFiscais         NotaFiscal[]
  ocorrencias          Ocorrencia[]
  naturezasOperacao    NaturezaOperacao[]
  certificadosDigitais CertificadoDigital[]
  precosCompra         PrecoCompra[]
  configuracaoFiscal   ConfiguracaoFiscal?

  @@map("empresas")
}

model Usuario {
  id             String      @id @default(uuid()) @db.Uuid
  empresaId      String      @map("empresa_id") @db.Uuid
  nome           String
  email          String      @unique
  role           RoleUsuario
  ativo          Boolean     @default(true)
  ultimoAcessoEm DateTime?   @map("ultimo_acesso_em")
  criadoEm       DateTime    @default(now()) @map("criado_em")
  atualizadoEm   DateTime    @updatedAt @map("atualizado_em")

  empresa                Empresa                     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  permissoes             PermissaoUsuario[]
  ajustesEstoqueLancados MovimentoEstoque[]
  bloqueiosSolicitados   BloqueioFinanceiroCliente[] @relation("BloqueioSolicitadoPor")
  bloqueiosAutorizados   BloqueioFinanceiroCliente[] @relation("BloqueioAutorizadoPor")
  sessaoAtiva            SessaoAtiva?

  @@index([empresaId])
  @@map("usuarios")
}

// Um usuário, uma sessão — o campo @unique em usuarioId é o que garante "1
// dispositivo por vez" no nível do banco: reclamar uma sessão nova é sempre
// um upsert que substitui a linha anterior, nunca uma segunda linha. O
// `sessaoId` é gerado pelo cliente (não é o JWT em si) e viaja em todo
// request via header X-Session-Id; o middleware `auth` compara os dois e
// derruba com 401 SESSION_REVOKED quem estiver com o valor antigo. Ver
// src/middlewares/auth.js e src/modules/auth/me/service.js.
model SessaoAtiva {
  id             String   @id @default(uuid()) @db.Uuid
  usuarioId      String   @unique @map("usuario_id") @db.Uuid
  sessaoId       String   @map("sessao_id")
  dispositivo    String?  @map("dispositivo")
  criadaEm       DateTime @default(now()) @map("criada_em")
  ultimoAcessoEm DateTime @default(now()) @map("ultimo_acesso_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("sessoes_ativas")
}

// Override fino de permissão por ação, usado pelo middleware requirePermissao
// para liberar ou bloquear uma ação específica de um usuário sem depender só
// do papel (role) dele — ex.: liberar "cancelar título" para alguém do
// financeiro que normalmente não teria essa ação. Quando não existe registro
// aqui para (usuarioId, modulo, acao), vale o papel padrão definido no
// catálogo de permissões do backend.
model PermissaoUsuario {
  id           String   @id @default(uuid()) @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  modulo       String
  acao         String
  permitida    Boolean
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, modulo, acao])
  @@index([usuarioId])
  @@map("permissoes_usuario")
}

model Colaborador {
  id           String          @id @default(uuid()) @db.Uuid
  empresaId    String          @map("empresa_id") @db.Uuid
  nome         String
  tipo         TipoColaborador
  ativo        Boolean         @default(true)
  criadoEm     DateTime        @default(now()) @map("criado_em")
  atualizadoEm DateTime        @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  pedidosCompraComprador PedidoCompra[]     @relation("CompradorPedidoCompra")
  pedidosVendaVendedor   PedidoVenda[]      @relation("VendedorPedidoVenda")
  pedidosVendaSeparador  PedidoVenda[]      @relation("SeparadorPedidoVenda")
  clientesVendedorPadrao Cliente[]          @relation("VendedorPadraoCliente")
  inventariosResponsavel InventarioFisico[] @relation("ResponsavelInventario")

  @@index([empresaId, tipo])
  @@map("colaboradores")
}

// =========================================================================
// CADASTROS
// =========================================================================

model Departamento {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  codigo       String
  nome         String
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa    Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  categorias Categoria[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@map("departamentos")
}

model Categoria {
  id             String   @id @default(uuid()) @db.Uuid
  empresaId      String   @map("empresa_id") @db.Uuid
  departamentoId String   @map("departamento_id") @db.Uuid
  codigo         String
  nome           String
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  departamento Departamento @relation(fields: [departamentoId], references: [id], onDelete: Restrict)
  produtos     Produto[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([departamentoId])
  @@map("categorias")
}

model UnidadeMedida {
  id             String   @id @default(uuid()) @db.Uuid
  empresaId      String   @map("empresa_id") @db.Uuid
  sigla          String
  descricao      String
  fatorConversao Decimal  @default(1) @map("fator_conversao") @db.Decimal(14, 6)
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  produtos Produto[]

  @@unique([empresaId, sigla])
  @@index([empresaId])
  @@map("unidades_medida")
}

model Produto {
  id              String   @id @default(uuid()) @db.Uuid
  empresaId       String   @map("empresa_id") @db.Uuid
  codigo          String
  descricao       String
  unidadeMedidaId String   @map("unidade_medida_id") @db.Uuid
  categoriaId     String   @map("categoria_id") @db.Uuid
  ncm             String?
  cstCfopPadrao   String?  @map("cst_cfop_padrao")
  estoqueMinimo   Decimal  @default(0) @map("estoque_minimo") @db.Decimal(14, 4)
  estoqueMaximo   Decimal  @default(0) @map("estoque_maximo") @db.Decimal(14, 4)
  perecivel       Boolean  @default(false)
  controlaLote    Boolean  @default(false) @map("controla_lote")
  precoReferencia Decimal  @default(0) @map("preco_referencia") @db.Decimal(14, 4)
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  empresa       Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  unidadeMedida UnidadeMedida @relation(fields: [unidadeMedidaId], references: [id], onDelete: Restrict)
  categoria     Categoria     @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  itensTabelaPreco    ItemTabelaPreco[]
  itensPedidoCompra   ItemPedidoCompra[]
  itensPedidoVenda    ItemPedidoVenda[]
  itensDevolucaoVenda ItemDevolucaoVenda[]
  lotes               Lote[]
  movimentosEstoque   MovimentoEstoque[]
  itensInventario     ItemInventario[]
  itensNotaFiscal     ItemNotaFiscal[]
  precosCompra        PrecoCompra[]

  @@unique([empresaId, codigo])
  @@index([empresaId, ativo])
  @@index([categoriaId])
  @@map("produtos")
}

model RegraIcms {
  id            String   @id @default(uuid()) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  descricao     String
  cstOrigem     String   @map("cst_origem")
  cstTributacao String   @map("cst_tributacao")
  aliquota      Decimal  @db.Decimal(6, 4)
  baseCalculo   Decimal  @map("base_calculo") @db.Decimal(14, 4)
  modalidade    String
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId])
  @@map("regras_icms")
}

model RegraIpi {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  descricao    String
  cst          String
  aliquota     Decimal  @db.Decimal(6, 4)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId])
  @@map("regras_ipi")
}

model RegraPis {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  descricao    String
  cst          String
  aliquota     Decimal  @db.Decimal(6, 4)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId])
  @@map("regras_pis")
}

model RegraCofins {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  descricao    String
  cst          String
  aliquota     Decimal  @db.Decimal(6, 4)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId])
  @@map("regras_cofins")
}

model RegraIbs {
  id             String    @id @default(uuid()) @db.Uuid
  empresaId      String    @map("empresa_id") @db.Uuid
  descricao      String
  cst            String
  aliquota       Decimal   @db.Decimal(6, 4)
  vigenciaInicio DateTime  @map("vigencia_inicio") @db.Date
  vigenciaFim    DateTime? @map("vigencia_fim") @db.Date
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId])
  @@map("regras_ibs")
}

model RegraCbs {
  id             String    @id @default(uuid()) @db.Uuid
  empresaId      String    @map("empresa_id") @db.Uuid
  descricao      String
  cst            String
  aliquota       Decimal   @db.Decimal(6, 4)
  vigenciaInicio DateTime  @map("vigencia_inicio") @db.Date
  vigenciaFim    DateTime? @map("vigencia_fim") @db.Date
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId])
  @@map("regras_cbs")
}

model TabelaPreco {
  id             String    @id @default(uuid()) @db.Uuid
  empresaId      String    @map("empresa_id") @db.Uuid
  nome           String
  vigenciaInicio DateTime  @map("vigencia_inicio") @db.Date
  vigenciaFim    DateTime? @map("vigencia_fim") @db.Date
  ativa          Boolean   @default(true)
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  itens        ItemTabelaPreco[]
  clientes     Cliente[]
  pedidosVenda PedidoVenda[]

  @@index([empresaId, ativa])
  @@map("tabelas_preco")
}

model ItemTabelaPreco {
  id            String  @id @default(uuid()) @db.Uuid
  tabelaPrecoId String  @map("tabela_preco_id") @db.Uuid
  produtoId     String  @map("produto_id") @db.Uuid
  preco         Decimal @db.Decimal(14, 4)

  tabelaPreco TabelaPreco @relation(fields: [tabelaPrecoId], references: [id], onDelete: Cascade)
  produto     Produto     @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@unique([tabelaPrecoId, produtoId])
  @@map("itens_tabela_preco")
}

model CondicaoPagamento {
  id             String   @id @default(uuid()) @db.Uuid
  empresaId      String   @map("empresa_id") @db.Uuid
  descricao      String
  numeroParcelas Int      @map("numero_parcelas")
  intervaloDias  Int      @map("intervalo_dias")
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  participantes Participante[]
  pedidosCompra PedidoCompra[]
  pedidosVenda  PedidoVenda[]

  @@index([empresaId])
  @@map("condicoes_pagamento")
}

// =========================================================================
// PARTICIPANTES
// =========================================================================

model Participante {
  id                   String     @id @default(uuid()) @db.Uuid
  empresaId            String     @map("empresa_id") @db.Uuid
  tipoPessoa           TipoPessoa @map("tipo_pessoa")
  razaoSocial          String     @map("razao_social")
  nomeFantasia         String?    @map("nome_fantasia")
  cpfCnpj              String     @map("cpf_cnpj")
  ie                   String?
  condicaoPagamentoId  String?    @map("condicao_pagamento_id") @db.Uuid
  limiteCredito        Decimal    @default(0) @map("limite_credito") @db.Decimal(14, 4)
  despesasRepassaveis  Boolean    @default(false) @map("despesas_repassaveis")
  permiteEmissaoCheque Boolean    @default(false) @map("permite_emissao_cheque")
  isProdutorRural      Boolean    @default(false) @map("is_produtor_rural")
  dapProdutorRural     String?    @map("dap_produtor_rural")
  talaoProdutorRural   String?    @map("talao_produtor_rural")
  grupoEmpresasId      String?    @map("grupo_empresas_id") @db.Uuid
  ativo                Boolean    @default(true)
  criadoEm             DateTime   @default(now()) @map("criado_em")
  atualizadoEm         DateTime   @updatedAt @map("atualizado_em")

  empresa           Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  condicaoPagamento CondicaoPagamento? @relation(fields: [condicaoPagamentoId], references: [id], onDelete: SetNull)
  grupoEmpresas     GrupoEmpresas?     @relation(fields: [grupoEmpresasId], references: [id], onDelete: SetNull)

  enderecos          Endereco[]
  cliente            Cliente?
  fornecedor         Fornecedor?
  titulosFinanceiros TituloFinanceiro[]
  chequesTerceiros   ChequeTerceiro[]
  notasFiscais       NotaFiscal[]
  movimentosComodato MovimentoComodato[]
  // Só preenchido quando a transportadora também precisa ser cobrada via
  // título financeiro (Controle de Frete/Descarga) — Transportadora não é
  // um Participante por padrão, então esse vínculo é opcional.
  transportadora     Transportadora?

  @@unique([empresaId, cpfCnpj])
  @@index([empresaId, ativo])
  @@map("participantes")
}

model Endereco {
  id             String       @id @default(uuid()) @db.Uuid
  participanteId String       @map("participante_id") @db.Uuid
  tipo           TipoEndereco
  logradouro     String
  numero         String
  bairro         String
  cidade         String
  uf             String       @db.Char(2)
  cep            String

  participante Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)

  @@index([participanteId])
  @@map("enderecos")
}

model Cliente {
  participanteId     String                @id @map("participante_id") @db.Uuid
  bloqueioFinanceiro StatusBloqueioCliente @default(LIBERADO) @map("bloqueio_financeiro")
  vendedorPadraoId   String?               @map("vendedor_padrao_id") @db.Uuid
  rotaEntregaId      String?               @map("rota_entrega_id") @db.Uuid
  tabelaPrecoId      String?               @map("tabela_preco_id") @db.Uuid
  criadoEm           DateTime              @default(now()) @map("criado_em")
  atualizadoEm       DateTime              @updatedAt @map("atualizado_em")

  participante   Participante @relation(fields: [participanteId], references: [id], onDelete: Cascade)
  vendedorPadrao Colaborador? @relation("VendedorPadraoCliente", fields: [vendedorPadraoId], references: [id], onDelete: SetNull)
  rotaEntrega    RotaEntrega? @relation(fields: [rotaEntregaId], references: [id], onDelete: SetNull)
  tabelaPreco    TabelaPreco? @relation(fields: [tabelaPrecoId], references: [id], onDelete: SetNull)

  pedidosVenda PedidoVenda[]
  bloqueios    BloqueioFinanceiroCliente[]
  ocorrencias  Ocorrencia[]

  @@index([bloqueioFinanceiro])
  @@map("clientes")
}

// Histórico/workflow de solicitação de bloqueio ou desbloqueio financeiro de
// um cliente — Cliente.bloqueioFinanceiro continua sendo o estado efetivo
// atual (é o que pedidosVenda.service usa pra barrar pedido novo), esta
// tabela é a trilha de quem pediu e quem autorizou cada mudança.
model BloqueioFinanceiroCliente {
  id              String         @id @default(uuid()) @db.Uuid
  clienteId       String         @map("cliente_id") @db.Uuid
  tipo            TipoBloqueio
  status          StatusBloqueio @default(SOLICITADO)
  motivo          String?
  solicitadoPorId String?        @map("solicitado_por_id") @db.Uuid
  autorizadoPorId String?        @map("autorizado_por_id") @db.Uuid
  decididoEm      DateTime?      @map("decidido_em")
  criadoEm        DateTime       @default(now()) @map("criado_em")
  atualizadoEm    DateTime       @updatedAt @map("atualizado_em")

  cliente       Cliente  @relation(fields: [clienteId], references: [participanteId], onDelete: Cascade)
  solicitadoPor Usuario? @relation("BloqueioSolicitadoPor", fields: [solicitadoPorId], references: [id], onDelete: SetNull)
  autorizadoPor Usuario? @relation("BloqueioAutorizadoPor", fields: [autorizadoPorId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@map("bloqueios_financeiros_cliente")
}

model Fornecedor {
