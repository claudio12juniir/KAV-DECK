model PedidoVenda {
  id                  String            @id @default(uuid()) @db.Uuid
  empresaId           String            @map("empresa_id") @db.Uuid
  clienteId           String            @map("cliente_id") @db.Uuid
  vendedorId          String?           @map("vendedor_id") @db.Uuid
  tabelaPrecoId       String?           @map("tabela_preco_id") @db.Uuid
  condicaoPagamentoId String?           @map("condicao_pagamento_id") @db.Uuid
  rotaEntregaId       String?           @map("rota_entrega_id") @db.Uuid
  separadorId         String?           @map("separador_id") @db.Uuid
  turno               TurnoEntrega?
  dataEmissao         DateTime          @default(now()) @map("data_emissao")
  status              StatusPedidoVenda @default(ABERTO)
  criadoEm            DateTime          @default(now()) @map("criado_em")
  atualizadoEm        DateTime          @updatedAt @map("atualizado_em")

  empresa           Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cliente           Cliente            @relation(fields: [clienteId], references: [participanteId], onDelete: Restrict)
  vendedor          Colaborador?       @relation("VendedorPedidoVenda", fields: [vendedorId], references: [id], onDelete: SetNull)
  separador         Colaborador?       @relation("SeparadorPedidoVenda", fields: [separadorId], references: [id], onDelete: SetNull)
  tabelaPreco       TabelaPreco?       @relation(fields: [tabelaPrecoId], references: [id], onDelete: SetNull)
  condicaoPagamento CondicaoPagamento? @relation(fields: [condicaoPagamentoId], references: [id], onDelete: SetNull)
  rotaEntrega       RotaEntrega?       @relation(fields: [rotaEntregaId], references: [id], onDelete: SetNull)

  itens                 ItemPedidoVenda[]
  devolucoes            DevolucaoVenda[]
  titulosFinanceiros    TituloFinanceiro[]
  notasFiscais          NotaFiscal[]
  movimentosEstoque     MovimentoEstoque[]
  notasFiscaisAgrupadas NotaFiscalPedidoVenda[]
  ocorrencias           Ocorrencia[]

  @@index([empresaId, status])
  @@index([clienteId])
  @@map("pedidos_venda")
}

// Log append-only de problemas ligados a um pedido/cliente (atraso na
// entrega, produto com defeito, recusa no recebimento etc.) — só
// registrar e consultar, sem edição posterior, igual ao "Adicionar" único
// visto no módulo equivalente do sistema de referência.
model Ocorrencia {
  id            String   @id @default(uuid()) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  pedidoVendaId String?  @map("pedido_venda_id") @db.Uuid
  clienteId     String?  @map("cliente_id") @db.Uuid
  tipo          String
  motivo        String
  data          DateTime @default(now())
  criadoEm      DateTime @default(now()) @map("criado_em")

  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  pedidoVenda PedidoVenda? @relation(fields: [pedidoVendaId], references: [id], onDelete: SetNull)
  cliente     Cliente?     @relation(fields: [clienteId], references: [participanteId], onDelete: SetNull)

  @@index([empresaId, data])
  @@map("ocorrencias")
}

model ItemPedidoVenda {
