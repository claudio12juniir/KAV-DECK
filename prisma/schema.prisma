// =========================================================================
// COMPRAS
// =========================================================================

model PedidoCompra {
  id                  String             @id @default(uuid()) @db.Uuid
  empresaId           String             @map("empresa_id") @db.Uuid
  fornecedorId        String             @map("fornecedor_id") @db.Uuid
  compradorId         String?            @map("comprador_id") @db.Uuid
  condicaoPagamentoId String?            @map("condicao_pagamento_id") @db.Uuid
  transportadoraId    String?            @map("transportadora_id") @db.Uuid
  valorFrete          Decimal            @default(0) @map("valor_frete") @db.Decimal(14, 4)
  freteFaturado       Boolean            @default(false) @map("frete_faturado")
  dataEmissao         DateTime           @default(now()) @map("data_emissao")
  status              StatusPedidoCompra @default(ABERTO)
  criadoEm            DateTime           @default(now()) @map("criado_em")
  atualizadoEm        DateTime           @updatedAt @map("atualizado_em")

  empresa           Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  fornecedor        Fornecedor         @relation(fields: [fornecedorId], references: [participanteId], onDelete: Restrict)
  comprador         Colaborador?       @relation("CompradorPedidoCompra", fields: [compradorId], references: [id], onDelete: SetNull)
  condicaoPagamento CondicaoPagamento? @relation(fields: [condicaoPagamentoId], references: [id], onDelete: SetNull)
  transportadora    Transportadora?    @relation(fields: [transportadoraId], references: [id], onDelete: SetNull)

  itens              ItemPedidoCompra[]
  titulosFinanceiros TituloFinanceiro[]
  notasFiscais       NotaFiscal[]
  movimentosEstoque  MovimentoEstoque[]

  @@index([empresaId, status])
  @@index([fornecedorId])
  @@index([transportadoraId, freteFaturado])
  @@map("pedidos_compra")
}

// Preço de compra vigente por fornecedor/produto — separado de TabelaPreco
// de propósito: TabelaPreco é do lado de vendas (vinculada a Cliente), aqui
// o preço varia por fornecedor, não faz sentido reaproveitar a mesma tabela.
model PrecoCompra {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  fornecedorId String   @map("fornecedor_id") @db.Uuid
  produtoId    String   @map("produto_id") @db.Uuid
  preco        Decimal  @db.Decimal(14, 4)
  vigenciaEm   DateTime @default(now()) @map("vigencia_em")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa    Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [participanteId], onDelete: Cascade)
  produto    Produto    @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([fornecedorId, produtoId])
  @@index([empresaId])
  @@map("precos_compra")
}

model ItemPedidoCompra {
  id             String  @id @default(uuid()) @db.Uuid
  pedidoCompraId String  @map("pedido_compra_id") @db.Uuid
  produtoId      String  @map("produto_id") @db.Uuid
  loteId         String? @map("lote_id") @db.Uuid
  quantidade     Decimal @db.Decimal(14, 4)
  precoUnitario  Decimal @map("preco_unitario") @db.Decimal(14, 4)

  pedidoCompra PedidoCompra @relation(fields: [pedidoCompraId], references: [id], onDelete: Cascade)
  produto      Produto      @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  lote         Lote?        @relation(fields: [loteId], references: [id], onDelete: SetNull)

  @@index([pedidoCompraId])
  @@index([produtoId])
  @@map("itens_pedido_compra")
}

