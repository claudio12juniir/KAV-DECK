}

model MovimentoComodato {
  id                   String                @id @default(uuid()) @db.Uuid
  empresaId            String                @map("empresa_id") @db.Uuid
  participanteId       String                @map("participante_id") @db.Uuid
  tipoCaixaEmbalagemId String                @map("tipo_caixa_embalagem_id") @db.Uuid
  tipo                 TipoMovimentoComodato
  quantidade           Decimal               @db.Decimal(14, 4)
  data                 DateTime              @default(now())

  empresa            Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  participante       Participante       @relation(fields: [participanteId], references: [id], onDelete: Restrict)
  tipoCaixaEmbalagem TipoCaixaEmbalagem @relation(fields: [tipoCaixaEmbalagemId], references: [id], onDelete: Restrict)

