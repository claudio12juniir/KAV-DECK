// =========================================================================
// FINANCEIRO
// =========================================================================

model TituloFinanceiro {
  id               String       @id @default(uuid()) @db.Uuid
  empresaId        String       @map("empresa_id") @db.Uuid
  tipo             TipoTitulo
  participanteId   String       @map("participante_id") @db.Uuid
  numero           String
  valor            Decimal      @db.Decimal(14, 4)
  vencimento       DateTime     @db.Date
  formaPagamento   String       @map("forma_pagamento")
  status           StatusTitulo @default(ABERTO)
  boleto           String?
  nossoNumero      String?      @map("nosso_numero")
  pedidoCompraId   String?      @map("pedido_compra_id") @db.Uuid
  pedidoVendaId    String?      @map("pedido_venda_id") @db.Uuid
  tituloOrigemId   String?      @map("titulo_origem_id") @db.Uuid
  tituloAgrupadoId String?      @map("titulo_agrupado_id") @db.Uuid
  criadoEm         DateTime     @default(now()) @map("criado_em")
  atualizadoEm     DateTime     @updatedAt @map("atualizado_em")

  empresa          Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  participante     Participante       @relation(fields: [participanteId], references: [id], onDelete: Restrict)
  pedidoCompra     PedidoCompra?      @relation(fields: [pedidoCompraId], references: [id], onDelete: SetNull)
  pedidoVenda      PedidoVenda?       @relation(fields: [pedidoVendaId], references: [id], onDelete: SetNull)
  tituloOrigem     TituloFinanceiro?  @relation("ParcelasTitulo", fields: [tituloOrigemId], references: [id], onDelete: SetNull)
  parcelas         TituloFinanceiro[] @relation("ParcelasTitulo")
  // Quando este título foi absorvido por um agrupamento (ver agrupar() no
  // service), tituloAgrupado aponta pro título consolidado que passou a
  // representar a dívida; titulosAgrupados é a mão inversa, usada pelo
  // consolidado pra listar quem ele engloba.
  tituloAgrupado   TituloFinanceiro?  @relation("AgrupamentoTitulo", fields: [tituloAgrupadoId], references: [id], onDelete: SetNull)
  titulosAgrupados TituloFinanceiro[] @relation("AgrupamentoTitulo")

  baixas BaixaTitulo[]

  @@index([empresaId, status, tipo])
  @@index([participanteId])
  @@index([tituloOrigemId])
  @@index([tituloAgrupadoId])
  @@map("titulos_financeiros")
}

model BaixaTitulo {
