  temperaturaRecebimento Decimal?  @map("temperatura_recebimento") @db.Decimal(5, 2)
  veiculo                String?
  quantidadeInicial      Decimal   @map("quantidade_inicial") @db.Decimal(14, 4)
  quantidadeAtual        Decimal   @map("quantidade_atual") @db.Decimal(14, 4)
