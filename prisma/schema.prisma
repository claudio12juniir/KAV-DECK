  motivo             String?
  usuarioId          String?              @map("usuario_id") @db.Uuid
  data               DateTime             @default(now())

  empresa          Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  produto          Produto           @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  lote             Lote?             @relation(fields: [loteId], references: [id], onDelete: Restrict)
  pedidoCompra     PedidoCompra?     @relation(fields: [pedidoCompraId], references: [id], onDelete: SetNull)
  pedidoVenda      PedidoVenda?      @relation(fields: [pedidoVendaId], references: [id], onDelete: SetNull)
  inventarioFisico InventarioFisico? @relation(fields: [inventarioFisicoId], references: [id], onDelete: SetNull)
  usuario          Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([empresaId, produtoId])
  @@index([loteId])
  @@map("movimentos_estoque")
}

model InventarioFisico {
