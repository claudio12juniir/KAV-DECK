}

model ChequeTerceiro {
  id              String       @id @default(uuid()) @db.Uuid
  empresaId       String       @map("empresa_id") @db.Uuid
  participanteId  String       @map("participante_id") @db.Uuid
  numero          String
  valor           Decimal      @db.Decimal(14, 4)
  dataRecebimento DateTime     @default(now()) @map("data_recebimento")
  dataCompensacao DateTime?    @map("data_compensacao") @db.Date
  status          StatusCheque @default(EM_CARTEIRA)

  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  participante Participante @relation(fields: [participanteId], references: [id], onDelete: Restrict)

  @@index([empresaId, status])
  @@map("cheques_terceiros")
}

// =========================================================================
// FISCAL
// =========================================================================

model NotaFiscal {
  id                   String            @id @default(uuid()) @db.Uuid
  empresaId            String            @map("empresa_id") @db.Uuid
  serie                String
  numero               String
  chaveAcesso          String?           @unique @map("chave_acesso")
  naturezaOperacaoId   String            @map("natureza_operacao_id") @db.Uuid
  tipoOperacao         TipoOperacaoNF    @map("tipo_operacao")
  modeloDocumento      ModeloDocumentoNF @default(NFE) @map("modelo_documento")
  status               StatusNotaFiscal  @default(EM_DIGITACAO)
  participanteId       String            @map("participante_id") @db.Uuid
  certificadoDigitalId String?           @map("certificado_digital_id") @db.Uuid
  pedidoCompraId       String?           @map("pedido_compra_id") @db.Uuid
  pedidoVendaId        String?           @map("pedido_venda_id") @db.Uuid
  dataEmissao          DateTime          @default(now()) @map("data_emissao")
  criadoEm             DateTime          @default(now()) @map("criado_em")
  atualizadoEm         DateTime          @updatedAt @map("atualizado_em")

  empresa            Empresa             @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  naturezaOperacao   NaturezaOperacao    @relation(fields: [naturezaOperacaoId], references: [id], onDelete: Restrict)
  participante       Participante        @relation(fields: [participanteId], references: [id], onDelete: Restrict)
  certificadoDigital CertificadoDigital? @relation(fields: [certificadoDigitalId], references: [id], onDelete: SetNull)
  pedidoCompra       PedidoCompra?       @relation(fields: [pedidoCompraId], references: [id], onDelete: SetNull)
  pedidoVenda        PedidoVenda?        @relation(fields: [pedidoVendaId], references: [id], onDelete: SetNull)

  itens                 ItemNotaFiscal[]
  manifestacoes         ManifestacaoDestinatario[]
  // pedidoVendaId acima é o vínculo simples (1 nota – 1 pedido) usado no
  // fluxo normal de faturamento; pedidosVendaAgrupados é o vínculo N:N usado
  // só quando a nota nasce da ação de agrupar vários pedidos numa NF única.
  pedidosVendaAgrupados NotaFiscalPedidoVenda[]

  @@unique([empresaId, serie, numero])
  @@index([empresaId, status])
  @@map("notas_fiscais")
}

// Junção usada só pela ação de agrupar N pedidos de venda numa NF única
// (o vínculo simples fica em NotaFiscal.pedidoVendaId, que só cobre 1:1).
model NotaFiscalPedidoVenda {
  id            String @id @default(uuid()) @db.Uuid
  notaFiscalId  String @map("nota_fiscal_id") @db.Uuid
  pedidoVendaId String @map("pedido_venda_id") @db.Uuid

  notaFiscal  NotaFiscal  @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)
  pedidoVenda PedidoVenda @relation(fields: [pedidoVendaId], references: [id], onDelete: Cascade)

  @@unique([notaFiscalId, pedidoVendaId])
  @@index([pedidoVendaId])
  @@map("nota_fiscal_pedidos_venda")
}

model ItemNotaFiscal {
  id            String  @id @default(uuid()) @db.Uuid
  notaFiscalId  String  @map("nota_fiscal_id") @db.Uuid
  produtoId     String  @map("produto_id") @db.Uuid
  cfopId        String  @map("cfop_id") @db.Uuid
  quantidade    Decimal @db.Decimal(14, 4)
  valorUnitario Decimal @map("valor_unitario") @db.Decimal(14, 4)
  valorIcms     Decimal @default(0) @map("valor_icms") @db.Decimal(14, 4)
  valorIpi      Decimal @default(0) @map("valor_ipi") @db.Decimal(14, 4)
  valorPis      Decimal @default(0) @map("valor_pis") @db.Decimal(14, 4)
  valorCofins   Decimal @default(0) @map("valor_cofins") @db.Decimal(14, 4)

  notaFiscal NotaFiscal @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)
  produto    Produto    @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  cfop       Cfop       @relation(fields: [cfopId], references: [id], onDelete: Restrict)

  @@index([notaFiscalId])
  @@index([produtoId])
  @@map("itens_nota_fiscal")
}

model ManifestacaoDestinatario {
  id           String                 @id @default(uuid()) @db.Uuid
  notaFiscalId String                 @map("nota_fiscal_id") @db.Uuid
  tipoEvento   TipoEventoManifestacao @map("tipo_evento")
  data         DateTime               @default(now())

  notaFiscal NotaFiscal @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)

  @@index([notaFiscalId])
  @@map("manifestacoes_destinatario")
}

model Cfop {
  id        String @id @default(uuid()) @db.Uuid
  codigo    String @unique
  descricao String

  naturezasOperacao NaturezaOperacao[]
  itensNotaFiscal   ItemNotaFiscal[]

  @@map("cfops")
}

model NaturezaOperacao {
  id           String @id @default(uuid()) @db.Uuid
  empresaId    String @map("empresa_id") @db.Uuid
  descricao    String
  cfopPadraoId String @map("cfop_padrao_id") @db.Uuid

  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cfopPadrao   Cfop         @relation(fields: [cfopPadraoId], references: [id], onDelete: Restrict)
  notasFiscais NotaFiscal[]

  @@index([empresaId])
  @@map("naturezas_operacao")
}

model CertificadoDigital {
  id             String   @id @default(uuid()) @db.Uuid
  empresaId      String   @map("empresa_id") @db.Uuid
  nome           String
  dataVencimento DateTime @map("data_vencimento") @db.Date

  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  notasFiscais NotaFiscal[]

  @@index([empresaId])
  @@map("certificados_digitais")
}

// Parametrização única por empresa do módulo fiscal — ambiente (homologação
// trava qualquer tentativa de transmissão real até alguém trocar
// deliberadamente pra produção) e os dados de série/CSC usados na emissão.
model ConfiguracaoFiscal {
  id              String         @id @default(uuid()) @db.Uuid
  empresaId       String         @unique @map("empresa_id") @db.Uuid
  ambiente        AmbienteFiscal @default(HOMOLOGACAO)
  serieNfePadrao  String         @default("1") @map("serie_nfe_padrao")
  serieNfcePadrao String         @default("1") @map("serie_nfce_padrao")
  cscId           String?        @map("csc_id")
  cscToken        String?        @map("csc_token")
  criadoEm        DateTime       @default(now()) @map("criado_em")
  atualizadoEm    DateTime       @updatedAt @map("atualizado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("configuracoes_fiscais")
}
