  @@index([empresaId])
  @@map("grupos_empresas")
}

model Transportadora {
  id             String   @id @default(uuid()) @db.Uuid
  empresaId      String   @map("empresa_id") @db.Uuid
  razaoSocial    String   @map("razao_social")
  cnpj           String
  participanteId String?  @unique @map("participante_id") @db.Uuid
